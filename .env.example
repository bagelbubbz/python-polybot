# Polymarket CLOB API credentials
# Get from: https://docs.polymarket.com/#authentication
POLY_API_KEY=your_polymarket_api_key_here
POLY_PRIVATE_KEY=0xyour_ethereum_private_key_here

# Telegram bot for alerts
# Create via @BotFather — get chat_id by messaging @userinfobot
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Alchemy Polygon RPC (used for Polygon/CLOB transactions)
# Get from: https://dashboard.alchemy.com/
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key_here

# ─── Options Market Scanner ───────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tradier (https://developer.tradier.com)
TRADIER_API_TOKEN=your-tradier-api-token
# Use https://sandbox.tradier.com/v1 for paper trading
TRADIER_BASE_URL=https://api.tradier.com/v1
